# Cloudflare Pages — HTTP headers

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=*

# Cache static assets
/style.css
  Cache-Control: no-cache

/app.js
  Cache-Control: no-cache

/overlay.js
  Cache-Control: no-cache
